<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ebremer</groupId>
        <artifactId>falcon</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zarr</artifactId>
    <packaging>jar</packaging>

    <name>Falcon Zarr</name>
    <description>A pure-JDK 25, zero-runtime-dependency reader and writer for the Zarr storage format,
        implementing the Zarr v3 core specification.</description>

    <dependencies>
        <!-- Falcon's shared codecs (zstd, Blosc); like this module, they need nothing beyond java.base. -->
        <dependency>
            <groupId>com.ebremer</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test only. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- HttpStoreTest uses the JDK's com.sun.net.httpserver as an in-process test server.
                 The test compile patches the tests into the module, which must then read jdk.httpserver;
                 the tests run on the class path (see the parent POM), where jdk.httpserver is resolved by
                 default. The shipped module-info still requires nothing beyond java.base. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <!-- The public API's Javadoc stays complete: javac's doclint checks every public and
                         protected member of the exported packages, and a missing or malformed comment fails
                         the build. -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <showWarnings>true</showWarnings>
                            <compilerArgs>
                                <arg>-Xdoclint:all/protected</arg>
                                <arg>-Xdoclint/package:com.ebremer.falcon.zarr,com.ebremer.falcon.zarr.datatype,com.ebremer.falcon.zarr.json,com.ebremer.falcon.zarr.store</arg>
                                <arg>-Werror</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules=jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.ebremer.falcon.zarr=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- The corrupt-input tests run on their own, under a small stack and heap: unbounded
                         recursion or allocation on hostile input then fails them instead of passing on a
                         generously sized JVM. -->
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/RobustnessTest.java</exclude>
                                <exclude>**/DecodeBoundsTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fuzz</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/RobustnessTest.java</include>
                                <include>**/DecodeBoundsTest.java</include>
                            </includes>
                            <argLine>@{argLine} -Xss256k -Xmx128m</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
